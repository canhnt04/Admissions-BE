{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "AccessToken": "Placeholder_Super_Secret_Key_For_JWT_Validation_Needs_To_Be_At_Least_64_Characters_Long!"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "formal-route": {
        "ClusterId": "formal-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": {
          "Path": "/api/formal/{**catch-all}"
        }
      },
      "shortterm-route": {
        "ClusterId": "shortterm-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": {
          "Path": "/api/shortterm/{**catch-all}"
        }
      },
      "driving-route": {
        "ClusterId": "driving-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": {
          "Path": "/api/driving/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "https://localhost:5004/"
          }
        }
      },
      "formal-cluster": {
        "Destinations": {
          "formal-api": {
            "Address": "https://localhost:5001/"
          }
        }
      },
      "shortterm-cluster": {
        "Destinations": {
          "shortterm-api": {
            "Address": "https://localhost:5002/"
          }
        }
      },
      "driving-cluster": {
        "Destinations": {
          "driving-api": {
            "Address": "https://localhost:5003/"
          }
        }
      }
    }
  }
}